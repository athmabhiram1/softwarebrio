# Copy to .env and fill secrets: copy .env.example .env  (Windows) / cp .env.example .env (macOS/Linux)
# Never commit .env — it is gitignored. No real secrets are in this file.

# --- LLM provider -----------------------------------------------------------
# "groq" (default) or "ollama" (local fallback). Both use the openai SDK compat client.
MODEL_PROVIDER=groq

# required for Groq path; get one free at console.groq.com
GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=llama3.1:8b
# localhost default for host runs; compose overrides to host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Fetching ---------------------------------------------------------------
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
FETCH_TIMEOUT_S=10
ESCALATE_MIN_CLEAN_CHARS=500

# --- Crawl scope ------------------------------------------------------------
SUBPAGE_PATTERN=/(?:about|team|company|contact|pricing|leadership)(?:[/?#]|$)
MAX_SUBPAGES=5

# --- Cleaning / token budget ------------------------------------------------
TOKEN_BUDGET=6000
PAGE_PRIORITY=team,leadership,contact,about,company,homepage,pricing

# --- Extraction -------------------------------------------------------------
LLM_FIELD_COUNT=4
RATE_LIMIT_BACKOFF_S=5

# --- Run inputs/outputs -----------------------------------------------------
TARGET_DOMAINS=postman.com,supabase.com,vapi.ai
OUTPUT_PATH=output.local.json

# --- Bonus seam (NOT-BUILT) -------------------------------------------------
# NOT-BUILT bonus seam, unused by core
TAVILY_API_KEY=
